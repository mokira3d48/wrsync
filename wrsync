#!/usr/bin/env bash
#
# wrsync — rsync wrapper to send files/folders to an SSH server
#          using a named configuration file.
#
# Usage:
#   wrsync <source> <remote>:<remote_path>
#
# Examples:
#   wrsync ./my_folder myvps:~/my_project_dir
#   wrsync ./my_file   myvps:/opt/my_project_dir
#
# The config file is looked up in:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/wrsync/<remote>.conf
#
# Supported config keys (KEY=value format):
#   HOST           (required)  IP or hostname of the remote machine
#   USER           (required)  SSH username
#   PORT           (optional)  SSH port, defaults to 22
#   IDENTITY_FILE  (optional)  path to the SSH private key
#   RSYNC_OPTS     (optional)  extra rsync options
#   SSH_OPTS       (optional)  extra ssh options

set -o errexit
set -o nounset
set -o pipefail

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #
readonly PROGNAME="${0##*/}"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wrsync"

# --------------------------------------------------------------------------- #
# Logging helpers
# --------------------------------------------------------------------------- #

# Print to stderr, with a prefix and color when attached to a terminal.
_log() {
    local level="$1"; shift
    local color="" reset=""
    if [[ -t 2 ]]; then
        reset=$'\033[0m'
        case "$level" in
            ERROR) color=$'\033[0;31m' ;;
            WARN)  color=$'\033[0;33m' ;;
            INFO)  color=$'\033[0;32m' ;;
        esac
    fi
    printf '%s%s:%s %s\n' "$color" "$level" "$reset" "$*" >&2
}

err()  { _log ERROR "$@"; }
warn() { _log WARN  "$@"; }
info() { _log INFO  "$@"; }

# Print an error message then exit with the given code (defaults to 1).
die() {
    local code=1
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        code="$1"; shift
    fi
    err "$@"
    exit "$code"
}

usage() {
    cat <<EOF
Usage: $PROGNAME <source> <remote>:<remote_path>

Send a file or directory to an SSH server via rsync, using a named
configuration file.

Arguments:
  <source>                 Local file or directory to send.
  <remote>:<remote_path>   Target: config profile name and remote path.

Options:
  -n, --dry-run            Simulate the transfer without copying anything.
  -h, --help               Show this help.

The config file must live in:
  $CONFIG_DIR/<remote>.conf

Examples:
  $PROGNAME ./my_folder myvps:~/my_project_dir
  $PROGNAME ./my_file   myvps:/opt/my_project_dir
EOF
}

# --------------------------------------------------------------------------- #
# Dependency checks
# --------------------------------------------------------------------------- #
check_dependencies() {
    local dep
    for dep in rsync ssh; do
        command -v "$dep" >/dev/null 2>&1 \
            || die "Missing dependency: '$dep' is not installed."
    done
}

# --------------------------------------------------------------------------- #
# Loading and validating the config file
# --------------------------------------------------------------------------- #
# We read the file line by line (not via `source`) to avoid executing arbitrary
# code and to strictly control which keys are accepted.

# Config variables (populated by load_config).
CFG_HOST=""
CFG_USER=""
CFG_PORT="22"
CFG_IDENTITY_FILE=""
CFG_RSYNC_OPTS=""
CFG_SSH_OPTS=""

load_config() {
    local remote="$1"
    local config_file="$CONFIG_DIR/${remote}.conf"

    [[ -f "$config_file" ]] \
        || die "Config file not found: $config_file"

    # Warn if permissions are too open (the file may contain secrets).
    if [[ -n "$(find "$config_file" -perm /0077 2>/dev/null)" ]]; then
        warn "Permissions on $config_file are too open (recommended: chmod 600)."
    fi

    local lineno=0 line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))

        # Strip comments and skip blank lines.
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"   # trim leading whitespace
        line="${line%"${line##*[![:space:]]}"}"   # trim trailing whitespace
        [[ -z "$line" ]] && continue

        if [[ "$line" != *=* ]]; then
            die "Invalid line $lineno in $config_file: '$line'"
        fi

        key="${line%%=*}"
        value="${line#*=}"
        # Trim whitespace around key and value.
        key="${key// /}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        # Strip surrounding quotes if present.
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"

        case "$key" in
            HOST)          CFG_HOST="$value" ;;
            USER)          CFG_USER="$value" ;;
            PORT)          CFG_PORT="$value" ;;
            IDENTITY_FILE) CFG_IDENTITY_FILE="${value/#\~/$HOME}" ;;
            RSYNC_OPTS)    CFG_RSYNC_OPTS="$value" ;;
            SSH_OPTS)      CFG_SSH_OPTS="$value" ;;
            *) warn "Unknown key ignored (line $lineno): '$key'" ;;
        esac
    done < "$config_file"

    # Validate required fields.
    [[ -n "$CFG_HOST" ]] || die "'HOST' is missing in $config_file"
    [[ -n "$CFG_USER" ]] || die "'USER' is missing in $config_file"

    if ! [[ "$CFG_PORT" =~ ^[0-9]+$ ]] || (( CFG_PORT < 1 || CFG_PORT > 65535 )); then
        die "Invalid PORT in $config_file: '$CFG_PORT'"
    fi

    if [[ -n "$CFG_IDENTITY_FILE" && ! -r "$CFG_IDENTITY_FILE" ]]; then
        die "SSH key not found or not readable: $CFG_IDENTITY_FILE"
    fi
}

# --------------------------------------------------------------------------- #
# Main program
# --------------------------------------------------------------------------- #
main() {
    local dry_run=0
    local -a positional=()

    # Argument parsing.
    while (( $# > 0 )); do
        case "$1" in
            -h|--help)    usage; exit 0 ;;
            -n|--dry-run) dry_run=1; shift ;;
            --)           shift; while (( $# > 0 )); do positional+=("$1"); shift; done ;;
            -*)           die "Unknown option: $1 (see '$PROGNAME --help')" ;;
            *)            positional+=("$1"); shift ;;
        esac
    done

    if (( ${#positional[@]} != 2 )); then
        usage >&2
        die "Wrong number of arguments: expected 2, got ${#positional[@]}."
    fi

    local source="${positional[0]}"
    local target="${positional[1]}"

    check_dependencies

    # The source must exist locally.
    [[ -e "$source" ]] || die "Source not found: $source"

    # The target must follow the <remote>:<path> form.
    if [[ "$target" != *:* ]]; then
        die "Invalid target: '$target' (expected format: <remote>:<remote_path>)"
    fi
    local remote="${target%%:*}"
    local remote_path="${target#*:}"

    [[ -n "$remote" ]]      || die "Empty remote name in target '$target'."
    [[ -n "$remote_path" ]] || die "Empty remote path in target '$target'."

    load_config "$remote"

    # Build the SSH transport command.
    local -a ssh_cmd=(ssh -p "$CFG_PORT")
    [[ -n "$CFG_IDENTITY_FILE" ]] && ssh_cmd+=(-i "$CFG_IDENTITY_FILE")
    if [[ -n "$CFG_SSH_OPTS" ]]; then
        # shellcheck disable=SC2206  # intentional word splitting for options.
        local -a extra_ssh=($CFG_SSH_OPTS)
        ssh_cmd+=("${extra_ssh[@]}")
    fi

    # Build the rsync options.
    local -a rsync_opts=(
        --archive          # -a: recursive + preserves perms, times, links, etc.
        --compress         # -z: compress data during transfer.
        --human-readable   # readable sizes.
        --partial          # resume interrupted transfers.
        --progress         # show progress.
    )
    (( dry_run )) && rsync_opts+=(--dry-run)

    if [[ -n "$CFG_RSYNC_OPTS" ]]; then
        # shellcheck disable=SC2206  # intentional word splitting for options.
        local -a extra_rsync=($CFG_RSYNC_OPTS)
        rsync_opts+=("${extra_rsync[@]}")
    fi

    # Normalize the source: if it is a directory, strip any trailing slash so
    # that the directory itself is copied (not just its contents).
    if [[ -d "$source" ]]; then
        source="${source%/}"
    fi

    local destination="${CFG_USER}@${CFG_HOST}:${remote_path}"

    info "Transfer: $source -> $destination (port $CFG_PORT)"
    (( dry_run )) && warn "Dry-run mode (--dry-run): no file will be copied."

    # Run it. -e passes the full SSH transport to rsync.
    rsync "${rsync_opts[@]}" -e "${ssh_cmd[*]}" -- "$source" "$destination"

    info "Done successfully."
}

main "$@"
