# Example wrsync config.
# Copy it to: ~/.config/wrsync/myvps.conf  (chmod 600 recommended)

# --- Required ---
HOST=192.168.1.42          # IP or hostname of the remote machine
USER=arnold                # SSH username

# --- Optional ---
PORT=22                    # SSH port (default: 22)
IDENTITY_FILE=~/.ssh/id_ed25519   # SSH private key to use

# Extra options forwarded verbatim to rsync.
# Example: exclude files / delete remote files that no longer exist locally.
RSYNC_OPTS=--exclude=.git --exclude=node_modules

# Extra options forwarded to ssh.
SSH_OPTS=-o StrictHostKeyChecking=accept-new
